#include <windows.h>

// Icono de la aplicación
IDI_ICON1 ICON "assets/icons/stlrenderer.ico"

// Información de versión
VS_VERSION_INFO VERSIONINFO
FILEVERSION     STL_RENDERER_VERSION_RC
PRODUCTVERSION  STL_RENDERER_VERSION_RC
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // English (US), Unicode
        BEGIN
            VALUE "CompanyName", "SynrgStudio"
            VALUE "FileDescription", "STL to PNG Converter"
            VALUE "FileVersion", STL_RENDERER_VERSION
            VALUE "InternalName", "STLRenderer"
            VALUE "LegalCopyright", "Copyright (C) SynrgStudio. GPL-3.0"
            VALUE "OriginalFilename", "STLRenderer.exe"
            VALUE "ProductName", "STL Renderer"
            VALUE "ProductVersion", STL_RENDERER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END 